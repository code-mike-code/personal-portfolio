# Contact form: server-side send via public/contact.php (PHP mail() on hostido).
# The destination address lives in contact.php — no keys/env needed for the form.

# GitHub Configuration (for Projects component; public REST API, no token needed)
REACT_APP_GITHUB_USERNAME=your_github_username

# Google Analytics 4 (loaded only after cookie consent)
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
